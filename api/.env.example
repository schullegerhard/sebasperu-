# Copia a .env y ajusta. Sin DATABASE_URL la API corre EN MEMORIA (datos demo).
PORT=4000
JWT_SECRET=cambia-esta-clave-en-produccion

# --- PostgreSQL / Supabase (datos permanentes) ---
# En Supabase: Project → Connect → "Session pooler" (o "Direct connection").
# Reemplaza [YOUR-PASSWORD] y el host por los de tu proyecto.
# La API crea las tablas y siembra el catálogo automáticamente en el primer arranque.
#
# DATABASE_URL=postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Correo de confirmación de pedido (Gmail / SMTP) ---
# En Gmail: activa la verificación en 2 pasos y crea una "Contraseña de aplicación".
# Sin estas variables, la compra funciona pero no se envía el correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
MAIL_FROM=SebasPeru <tucorreo@gmail.com>

# --- Mercado Pago (Checkout Pro) ---
# Access Token de tu cuenta (TEST-… para pruebas, APP_USR-… en producción).
# Sin esto, la opción "Mercado Pago" no aparece en el checkout.
MP_ACCESS_TOKEN=
# URL pública de la API (back_urls y webhook de MP). Si se omite, se deduce del request.
# PUBLIC_URL=https://api.sebasperu.com
